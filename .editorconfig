root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# GDScript: tabs, as in the official style guide and Godot's editor
[*.gd]
indent_style = tab
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Trailing double spaces are line breaks in Markdown
[*.md]
trim_trailing_whitespace = false
