[ext_resource type="PackedScene" path="res://ui/cutscene_prompt.tscn" id="15_prompt"]
[ext_resource type="PackedScene" path="res://ui/build_tag.tscn" id="16_build_tag"]
[ext_resource type="Script" path="res://scripts/debug/cutscene_keys.gd" id="17_keys"]
