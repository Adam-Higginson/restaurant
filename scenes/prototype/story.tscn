[node name="Story" type="Node"]

[node name="Conversation" type="Node" parent="."]
script = ExtResource("1_talk")

[node name="ShotCues" type="Node" parent="."]
script = ExtResource("2_shots")

[node name="FadeCues" type="Node" parent="."]
script = ExtResource("3_fades")

[node name="WaitCues" type="Node" parent="." node_paths=PackedStringArray("prompt", "build_tag")]
script = ExtResource("4_waits")
prompt = NodePath("../CutscenePrompt")
build_tag = NodePath("../BuildTag")

[node name="ActorCues" type="Node" parent="."]
script = ExtResource("5_actors")

[node name="ChestCues" type="Node" parent="."]
script = ExtResource("6_chest")
creak = ExtResource("7_creak")
fanfare = ExtResource("8_fanfare")

[node name="ClipCues" type="Node" parent="."]
script = ExtResource("9_clips")

[node name="BookCues" type="Node" parent="."]
script = ExtResource("10_books")

[node name="SpeechCues" type="Node" parent="." node_paths=PackedStringArray("prompt")]
script = ExtResource("11_speech")
prompt = NodePath("../CutscenePrompt")

[node name="LookCues" type="Node" parent="."]
script = ExtResource("12_looks")

[node name="SoundCues" type="Node" parent="."]
script = ExtResource("13_sounds")

[node name="Confirm" type="AudioStreamPlayer" parent="SoundCues"]
stream = ExtResource("14_confirm")
volume_db = -8.0

[node name="CutscenePrompt" parent="." instance=ExtResource("15_prompt")]

[node name="BuildTag" parent="." instance=ExtResource("16_build_tag")]

[node name="CutsceneKeys" type="Node" parent="."]
script = ExtResource("17_keys")

[node name="DialogueFacts" type="Node" parent="."]
script = ExtResource("18_facts")

[node name="Chatter" type="Node" parent="."]
script = ExtResource("19_chatter")

[node name="TravelCues" type="Node" parent="."]
script = ExtResource("20_travel")

[node name="TimeCues" type="Node" parent="."]
script = ExtResource("21_time")
