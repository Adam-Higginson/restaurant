[gd_resource type="Resource" script_class="Book" format=3]

[ext_resource type="Script" path="res://scripts/data/book.gd" id="1_book"]
[ext_resource type="Script" path="res://scripts/data/book_page.gd" id="2_page"]

[sub_resource type="Resource" id="Title"]
script = ExtResource("2_page")
heading = "Of the Creatures and Spirits of the Sea"
lines = PackedStringArray("Being an account of what lives in it and what haunts it, set down from what sailors, lamplighters and ships' cooks have told.", "With a remedy.")

[sub_resource type="Resource" id="Nature"]
script = ExtResource("2_page")
heading = "The Little Lights"
lines = PackedStringArray("The little lights of the deep are creatures of warmth. Their flames are sustained by the heat of living things.", "They are particularly fond of strong spices. Their flames lean towards what they want.")

[sub_resource type="Resource" id="Sea"]
script = ExtResource("2_page")
heading = "Their Generosity"
lines = PackedStringArray("A little light will give its warmth away, and give too much. One that has done so is small and blue, and can barely hold itself up.", "It is not out. It is only very low.")

[sub_resource type="Resource" id="Feeding"]
script = ExtResource("2_page")
heading = "Their Feeding"
lines = PackedStringArray("Oil will keep a little light going, but it does not mend one. For that it must be fed as we are.", "It likes warm things best: spiced things, things that bite back.")

[sub_resource type="Resource" id="Remedy"]
script = ExtResource("2_page")
heading = "A Remedy"
lines = PackedStringArray("When a lantern's flame grows faint, a hot broth of ripe tomatoes, red chilli and wild herbs may restore its warmth.", "A bowl of red soup, well spiced, set down by it while it steams. It takes its warmth from the steam.")

[sub_resource type="Resource" id="After"]
script = ExtResource("2_page")
heading = "Afterwards"
lines = PackedStringArray("A light restored is brighter than before.", "Do not be alarmed if, once warm, it will not stop talking.")

[resource]
script = ExtResource("1_book")
title = "Of the Creatures and Spirits of the Sea"
pages = Array[ExtResource("2_page")]([SubResource("Title"), SubResource("Nature"), SubResource("Sea"), SubResource("Feeding"), SubResource("Remedy"), SubResource("After")])
opens_at = 4
